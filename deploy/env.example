# Copy to .env (never commit .env). docker compose reads it.
DOMAIN=chat.example.com
# Invite code people need to create an account. Leave empty to close signup. Choose a long random value.
AARAV_SIGNUP_CODE=change-me-to-something-long-and-random
# The model to serve (a file under ./models).
AARAV_CHECKPOINT=models/tiny-tinystories-v1-sft-int8.pt
